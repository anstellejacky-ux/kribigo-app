{
  "expo": {
    "name": "KribiGo",
    "slug": "kribigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kribigo-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anstellejacky.kribigofresh",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anstellejacky.kribigofresh",
      "icon": "./assets/kribigo-icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "48c775ca-45b8-49e1-bb9a-a58eaeeb0217"
      }
    },
    "owner": "anstellejacky"
  }
}